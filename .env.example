# Runtime
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# API
API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://connuoc:connuoc@localhost:5432/connuoc

# Redis / queue
REDIS_URL=redis://localhost:6379

# Object storage (optional in early development)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=connuoc
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Authentication — fill only in local env, never commit real secrets
AUTH_SECRET=

# Notifications
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# External data sources
# Add source-specific variables only after source licensing/adapter review.
