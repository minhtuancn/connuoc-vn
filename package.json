{
  "name": "connuoc-vn",
  "version": "0.0.0",
  "private": true,
  "description": "Con Nuoc Viet monorepo: tide, Vietnamese calendar and drainage decision-support platform",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:foundation": "node ./scripts/check-foundation.mjs",
    "build": "pnpm --filter './packages/**' --filter './services/**' build",
    "lint": "eslint 'packages/**/*.ts' 'services/**/*.ts'",
    "typecheck": "pnpm --filter './packages/**' --filter './services/**' typecheck",
    "test": "pnpm --filter './packages/**' --filter './services/**' test",
    "bench": "pnpm --filter @connuoc/tide-engine bench"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
