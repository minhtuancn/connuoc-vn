{
  "name": "@connuoc/job-queue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare:deps": "pnpm --filter @connuoc/shared-types build",
    "prebuild": "pnpm run prepare:deps",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm run prepare:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run prepare:deps",
    "test": "vitest run"
  },
  "dependencies": {
    "@connuoc/shared-types": "workspace:*",
    "bullmq": "6.3.4",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1"
  }
}
